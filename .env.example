# Local storage roots for pirate-compose_oph.local.yml (host paths).
# Recommended on Linux: ext4 on SSD/NVMe, not NTFS.
# Published stores the API serves from (~81 GiB: two versions of every model).
# Put this on the fastest disk; every API request reads from it.
PW_PROD_ROOT=/mnt/pirate-weather/Prod
# Ingest scratch space, one folder per model. Use a fast local disk: some
# ingests (GDPS) re-read tens of GB while writing. Peaks reach tens of GB per
# heavy model.
PW_WORK_ROOT=/mnt/pirate-weather/Work
# Short-term history stores (~30 GB, growing until pruned). A slower, larger
# disk is fine.
PW_HIST_ROOT=/mnt/pirate-weather/Hist

# The API reads <PW_PROD_ROOT>/v31/ETOPO_DA_C.zarr for elevation when true.
# No ingest produces it; leave false unless you have placed it there.
use_etopo=false

# Starting gap between NOMADS requests; it backs off on rate-limit responses.
nomads_request_interval_seconds=1
herbie_download_retries=3
herbie_retry_sleep_seconds=20

# Optional: enables live ingest comparisons against GribStream (tests/live only).
GRIBSTREAM_API_KEY=
