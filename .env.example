# Local ingest storage roots (host paths mounted into containers)
# Recommended on Linux: use an ext4 SSD-backed filesystem, not NTFS.
PW_WEATHER_ROOT=/mnt/pirate-weather/Weather
PW_WORK_ROOT=/mnt/pirate-weather/Work

# NBM uses the shared Herbie retries; NOMADS requests are paced individually.
nomads_request_interval_seconds=5
herbie_download_retries=3
herbie_retry_sleep_seconds=20

# Optional: enables live ingest comparisons against GribStream.
GRIBSTREAM_API_KEY=
