      ofelia.job-run.gfs-ingest.environment: '["wgrib2_path=/home/ubuntu/wgrib2_build/bin/wgrib2 ", "forecast_process_dir=/tmp/Process/GFS", "forecast_path=/data/Prod/GFS", "historic_path=/data/Hist/GFS", "save_type=Download"]'
